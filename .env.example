# ---------------------------------------------------------------------------
# CryptoVault - optional RPC overrides
#
# Everything works out of the box on free public endpoints. These are here for
# when you outgrow the public rate limits. All are NEXT_PUBLIC_ because the app
# is 100% client-side - NEVER put a secret that matters in this file.
# ---------------------------------------------------------------------------

# EVM (Alchemy / Infura / QuickNode / your own node)
NEXT_PUBLIC_RPC_ETHEREUM=
NEXT_PUBLIC_RPC_SEPOLIA=

# BNB Smart Chain
NEXT_PUBLIC_RPC_BSC=
NEXT_PUBLIC_RPC_BSC_TESTNET=

# Solana
NEXT_PUBLIC_RPC_SOLANA=
NEXT_PUBLIC_RPC_SOLANA_DEVNET=

# TON - toncenter.com works keyless but is heavily rate limited.
# Get a free key from @tonapibot on Telegram.
NEXT_PUBLIC_TONCENTER_KEY=
NEXT_PUBLIC_TONCENTER_TESTNET_KEY=

# XRP Ledger JSON-RPC
NEXT_PUBLIC_RPC_XRPL=
NEXT_PUBLIC_RPC_XRPL_TESTNET=

# Bitcoin - any mempool.space / esplora compatible instance
NEXT_PUBLIC_ESPLORA_MAINNET=
NEXT_PUBLIC_ESPLORA_TESTNET=

# ---------------------------------------------------------------------------
# Swap aggregators
#
# Required for the Swap tab. Both keys ship inside the client bundle and are
# therefore publicly readable - scope them to your domains in each dashboard.
# This does NOT weaken key custody: your seed phrase still never leaves the
# browser. If you need the keys hidden, put a thin proxy in front of these two
# APIs; nothing else about the architecture changes.
# ---------------------------------------------------------------------------

# 0x Swap API v2 - required for Ethereum and BSC swaps. https://dashboard.0x.org
NEXT_PUBLIC_ZEROX_API_KEY=

# Jupiter - optional. Without a key the keyless lite-api tier is used, which is
# rate limited but works. https://portal.jup.ag
NEXT_PUBLIC_JUPITER_API_KEY=

# ---------------------------------------------------------------------------
# Solana developer-fee payer (scripts/setup-solana-fees.mjs only, never bundled)
# Path to a Solana CLI keypair that funds the one-time fee-account creation.
# ---------------------------------------------------------------------------
SOLANA_FEE_PAYER=
